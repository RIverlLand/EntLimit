<Window x:Class="EntLimit.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EntLimit · 学一点，安心玩" Width="1320" Height="900" MinWidth="1000" MinHeight="700" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen" WindowStyle="SingleBorderWindow">
  <Grid x:Name="WindowShell"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#22FFFFFF" Offset="0"/><GradientStop Color="#08F3F6FC" Offset="1"/></LinearGradientBrush></Grid.Background><Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="1" Margin="0" TextElement.FontFamily="Microsoft Yahei UI" TextElement.Foreground="#24364C" TextElement.FontSize="14"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#30FFFFFF" BorderBrush="#85FFFFFF" BorderThickness="0,0,1,0"><DockPanel Margin="16,28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="EntLimit" FontSize="24" FontWeight="SemiBold" Margin="10,0,0,4"/><TextBlock Text="学一点 · 安心玩" Foreground="#7B899A" FontSize="12" Margin="10,0,0,30"/><Button x:Name="NavToday" Content="◉  今天的练习" Tag="0" Click="Navigate_Click" HorizontalContentAlignment="Left"/><Button Content="▦  受管控应用" Tag="1" Click="Navigate_Click" HorizontalContentAlignment="Left"/><Button Content="⚙  规则与网站" Tag="2" Click="Navigate_Click" HorizontalContentAlignment="Left"/><Button Content="◷  学习记录" Tag="3" Click="Navigate_Click" HorizontalContentAlignment="Left"/><Button x:Name="NavIntegrations" Content="☁  API 与扩展" Tag="4" Click="Navigate_Click" HorizontalContentAlignment="Left"/></StackPanel><TextBlock DockPanel.Dock="Bottom" Text="按自己的节奏，&#10;一点一点积累。" Foreground="#8593A5" FontSize="12" LineHeight="23" VerticalAlignment="Bottom" Margin="10,0,0,8"/></DockPanel></Border>
    <Grid Grid.Column="1" Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel x:Name="WorkspaceHeader" MinHeight="44" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="练习工作台" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="WorkspaceSubtitle" Text="每次一点积累，保持自己的节奏。" Foreground="#637E7D" Margin="0,6,0,0"/></StackPanel>
      <Button Content="刷新状态" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Refresh_Click"/>
    </DockPanel>
    <Border Grid.Row="1" Background="#68D9E8FB" CornerRadius="16" Padding="18" Margin="0,0,0,12">
      <DockPanel><Button DockPanel.Dock="Right" Content="这次已结束" Click="Finish_Click" HorizontalAlignment="Right" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="StatusTitle" Text="正在连接后台…" Foreground="#345B93" FontSize="20"/><TextBlock x:Name="StatusDetail" Foreground="#627B9D" TextWrapping="Wrap" Margin="0,8,16,0"/></StackPanel></DockPanel>
    </Border>
    <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
      <TabItem Header="今天 · 练习">
        <Grid Margin="22,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,14"><TextBlock x:Name="LearningHeading" Text="留下一点收获，再安心玩。" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="LearningSubtitle" Text="选择一种节奏。轻松复习与完整练习，获得同样的 90 分钟起许可。" Foreground="#68798C" Margin="0,8,0,12" TextWrapping="Wrap"/>
            <WrapPanel><ComboBox x:Name="ModeBox" Width="140" SelectionChanged="QuestionFilter_Changed"><ComboBoxItem Content="今天学一点" Tag="standard"/><ComboBoxItem Content="轻松复习" Tag="light"/></ComboBox><ComboBox x:Name="TopicBox" Width="155" SelectionChanged="QuestionFilter_Changed"><ComboBoxItem Content="编程 · Python" Tag="python"/><ComboBoxItem Content="计算机网络基础" Tag="network"/><ComboBoxItem Content="全部题集" Tag="all"/></ComboBox><ComboBox x:Name="StrategyBox" Width="120" SelectionChanged="QuestionFilter_Changed" ToolTip="推荐按通过/复习进度排序；随机只在当前优先候选中抽题，不跳过尚未掌握的内容。"><ComboBoxItem Content="推荐选题" Tag="recommended"/><ComboBoxItem Content="随机选题" Tag="random"/></ComboBox><Button x:Name="NextExerciseButton" Width="80" Padding="10,9" Content="换一道" Click="NextQuestion_Click"/><Button x:Name="RestartButton" Width="125" Padding="10,9" Content="重新开始本题" Click="RestartQuestion_Click"/></WrapPanel>
            <TextBlock x:Name="LearningProgress" Foreground="#5277B0" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="SelectionNote" Foreground="#68798C" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
          </StackPanel>
          <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition x:Name="ExerciseDivider" Width="0"/><ColumnDefinition x:Name="CodeColumn" Width="0" MinWidth="0"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource GlassCard}" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" CornerRadius="18" Padding="22">
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="QuestionMeta" Foreground="#5277B0" FontSize="12"/><TextBlock x:Name="QuestionProgress" Foreground="#2D7966" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock x:Name="QuestionTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,14"/><WrapPanel x:Name="TopologyPanel" Margin="0,0,0,12"/><TextBlock x:Name="QuestionPrompt" FontFamily="Microsoft YaHei UI" TextWrapping="Wrap" LineHeight="25" Foreground="#42536B"/><StackPanel x:Name="AnswerPanel" Margin="0,18,0,0"/>
                <Border Background="#70EDF4FE" CornerRadius="10" Padding="14" Margin="0,18,0,0"><TextBlock x:Name="HintText" Text="先试一试；需要时，可以逐步展开提示。" TextWrapping="Wrap" Foreground="#4D6583" LineHeight="23"/></Border>
                <TextBlock x:Name="Feedback" TextWrapping="Wrap" LineHeight="25" Margin="0,18,0,0" Foreground="#2E6E63"/>
              </StackPanel></ScrollViewer>
            </Border>
            <GridSplitter x:Name="CodeSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Visibility="Collapsed" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
            <Border x:Name="NetworkPanel" Grid.Column="2" Background="#88FFFFFF" CornerRadius="18" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,14"><TextBlock Text="把知识用到这个场景里" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="逐问回答；答错的部分可以修改后重试。" Foreground="#7B899A" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NetworkAnswers"/></ScrollViewer></Grid></Border>
            <Border x:Name="CodePanel" Grid.Column="2" Background="#88FFFFFF" CornerRadius="18" BorderBrush="{StaticResource GlassLine}" BorderThickness="1" Padding="16" Visibility="Collapsed">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*" MinHeight="60"/><RowDefinition Height="Auto"/><RowDefinition Height="2*" MinHeight="90"/></Grid.RowDefinitions>
                <DockPanel><TextBlock x:Name="CodeLanguageTitle" Text="Python 工作台" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" HorizontalAlignment="Right" x:Name="SelectRuntimeButton" Content="选择 Python…" Click="SelectPython_Click" Padding="10,6"/></DockPanel>
                <TextBlock x:Name="RuntimeLabel" Grid.Row="1" Text="选择已有 Python 3 运行环境；本样板不自动下载。" Foreground="#68798C" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="11" Margin="0,5,0,9"/>
                <AdornerDecorator Grid.Row="2"><Grid Background="#50F5F8FC"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer x:Name="LineScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="LineNumbers" Text="1" FontFamily="Consolas" FontSize="16" LineHeight="23" Padding="4,10,0,10" Foreground="#9AA8BB" TextAlignment="Right"/></ScrollViewer><TextBox x:Name="CodeEditor" Grid.Column="1" FontFamily="Consolas" FontSize="16" TextBlock.LineHeight="23" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0" Margin="0" Padding="8,10" SpellCheck.IsEnabled="False" TextChanged="CodeEditor_Changed" PreviewKeyDown="CodeEditor_KeyDown" ScrollViewer.ScrollChanged="CodeEditor_Scrolled"/></Grid></AdornerDecorator>
                <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNS" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ToolTip="拖动调整编辑区和结果 / 分析区高度"/><DockPanel Grid.Row="3" Margin="0,14,0,6"><TextBlock Text="结果与分析" VerticalAlignment="Center" FontWeight="SemiBold"/><Button x:Name="CancelCodeButton" Content="停止运行" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="CancelCode_Click" IsEnabled="False" Padding="10,6"/></DockPanel>
                <TabControl x:Name="CodeOutputTabs" Grid.Row="4" BorderThickness="0" Background="Transparent"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Visible"/><Setter Property="Padding" Value="9,5"/></Style></TabControl.Resources><TabItem Header="运行结果">                <TextBox x:Name="CodeResults" Margin="0" Padding="6,3" IsReadOnly="True" Text="运行示例，先看一看函数的实际输出。" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Background="#50F5F8FC" BorderThickness="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"/></TabItem><TabItem x:Name="AnalysisTab" Header="解答分析"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="AnalysisContent" Margin="8"/></ScrollViewer></TabItem></TabControl>
              </Grid>
            </Border>
          </Grid>
          <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><WrapPanel><Button x:Name="CompleteButton" Content="提交检查，获得许可" Style="{StaticResource PrimaryButton}" Click="Complete_Click"/><Button x:Name="CloudAnalyzeButton" Content="在线分析（发送当前代码）" Click="CloudAnalyze_Click" Visibility="Collapsed" ToolTip="仅此按钮会把题目与当前代码发送到API设置页的服务；本地分析不上传。"/><Button x:Name="AnalyzeCodeButton" Content="分析当前解答" Click="AnalyzeCode_Click" Visibility="Collapsed" ToolTip="按需分析当前代码结构，不运行代码，不授予许可。"/><Button x:Name="RunExamplesButton" Content="运行示例" Click="RunExamples_Click" Visibility="Collapsed"/><Button Content="给我一点提示" Click="Hint_Click"/><Button Content="参考资料 ↗" Click="Source_Click"/></WrapPanel><TextBlock x:Name="PracticeNote" Grid.Row="1" Foreground="#7B8797" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" Text="练习无倒计时。答案与代码草稿保存在本机。"/></Grid>
        </Grid>
      </TabItem>
      <TabItem Header="受管控应用">
        <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="1*" MinHeight="85"/><RowDefinition Height="14"/><RowDefinition Height="3*" MinHeight="150"/></Grid.RowDefinitions>
          <TextBlock Text="添加、移除和启停会立即保存。系统组件、输入法和开发工具默认排除；后台不会持续扫描磁盘。" TextWrapping="Wrap"/>
          <WrapPanel Grid.Row="1" Margin="0,8"><Button Content="重新扫描" Click="Scan_Click"/><Button Content="手动添加 EXE" Click="ManualAdd_Click"/><Button Content="移除选中项" Click="RemoveApp_Click"/><Button Content="启动选中应用" Click="Launch_Click"/></WrapPanel>
          <DataGrid x:Name="ManagedGrid" Grid.Row="2" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTemplateColumn Header="启用" Width="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Click="ManagedEnabled_Click" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="已管控应用" Binding="{Binding Name}" IsReadOnly="True" Width="190"/><DataGridTextColumn Header="EXE 路径" Binding="{Binding ExecutablePath}" IsReadOnly="True" Width="*"/></DataGrid.Columns></DataGrid>
          <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#7FAFC4DF" ShowsPreview="False" Cursor="SizeNS" ToolTip="上下拖动，调整已管控列表和候选列表的高度"/>
          <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel><TextBox x:Name="CatalogSearchBox" Width="270" TextChanged="CatalogFilter_Changed" ToolTip="按软件名称或路径搜索，例如 百度、Baidu、Steam"/><ComboBox x:Name="CatalogSourceBox" Width="190" SelectionChanged="CatalogSource_Changed" SelectedIndex="0"><ComboBoxItem Content="所有可选应用" Tag="all"/><ComboBoxItem Content="已安装的软件" Tag="installed"/><ComboBoxItem Content="Steam 游戏" Tag="steam"/><ComboBoxItem Content="扫描时有窗口的应用" Tag="running"/></ComboBox><Button x:Name="AddCandidatesButton" Content="添加选中项并保存" Click="AddCandidate_Click"/></WrapPanel>
            <TextBlock x:Name="CatalogCount" Grid.Row="1" Foreground="#657C78" Margin="0,4,0,8" Text="可以输入名称搜索；按 Ctrl / Shift 多选。上下列表之间的横条可以拖动。" TextWrapping="Wrap"/>
            <DataGrid x:Name="CatalogGrid" Grid.Row="2" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"><DataGrid.Columns><DataGridTextColumn Header="软件名称" Binding="{Binding Name}" Width="210"/><DataGridTextColumn Header="发现来源" Binding="{Binding Source}" Width="220"/><DataGridTextColumn Header="路径（可调整列宽）" Binding="{Binding ExecutablePath}" Width="*" MinWidth="180"/></DataGrid.Columns></DataGrid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="规则与网站">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
          <TextBlock Text="第一条规则：学习后解锁，结束时温和收尾" FontSize="21" TextWrapping="Wrap"/>
          <TextBlock Text="设置对下一次学习许可生效；已经获得的许可不会缩短。第一版统一管控，不区分工作日与休假。" TextWrapping="Wrap" Foreground="#657C78" Margin="0,10,0,16"/>
          <WrapPanel><TextBlock Text="解锁分钟（至少 90）" VerticalAlignment="Center"/><TextBox x:Name="MinutesBox" Width="90"/><TextBlock Text="提前提醒分钟" VerticalAlignment="Center"/><TextBox x:Name="WarningBox" Width="90"/></WrapPanel>
          <CheckBox x:Name="SoundBox" Content="到期 / 临近结束时使用简短声音提醒" Margin="0,10"/>
          <CheckBox x:Name="OverlayBox" Content="允许自建、不抢焦点的浮层提醒（建议先在无边框模式验证）" Margin="0,10"/>
          <TextBlock Text="浮层默认关闭。独占全屏可能看不到浮层；默认只发声音并更新托盘，不调用 Windows 通知、不打开学习窗口。" TextWrapping="Wrap" Foreground="#657C78" Margin="0,0,0,12"/>
          <Button Content="启动管理员窗口协助（安装版）" Click="StartAdminBroker_Click" HorizontalAlignment="Left" ToolTip="会显示 Windows UAC；仅协助高权限窗口。本次最多 8 小时，后台断连会退出，之后需手动重新授权。练习保持普通用户权限。"/>
          <TextBlock Text="自用守护" FontSize="18" Margin="0,8,0,4"/>
          <CheckBox x:Name="MonitoringBox" Content="启用应用与网站管控" Margin="0,8"/>
          <CheckBox x:Name="StartupBox" Content="登录 Windows 后自动启动轻量监控，不打开主界面" Margin="0,8"/>
          <CheckBox x:Name="GuardBox" Content="开启守护：监控被结束后恢复，普通退出需要走调试入口" Margin="0,8"/>
          <TextBlock Text="守护用于抵抗随手关闭的冲动。当前为同用户轻量守护，可以手动停用；家长密码和系统服务尚未启用。勾选后点击保存生效。" TextWrapping="Wrap" Foreground="#657C78" Margin="0,0,0,14"/>
          <TextBlock Text="受管控网站域名" FontSize="18"/><TextBox x:Name="DomainsBox" Height="85" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="例如 bilibili.com；每行一个，包含其子域名。"/>
          <TextBlock Text="需要手动安装 Edge / Chrome 扩展并注册桥接。已加载网页允许收尾，第一版无法通用识别视频结束。不要将整个浏览器 EXE 加入应用列表，除非确实想管控整个浏览器。" Foreground="#657C78" TextWrapping="Wrap"/>
          <Button Content="保存规则与域名" Click="SaveRules_Click" HorizontalAlignment="Left" Margin="0,18,0,4"/>
          <Expander Header="调试入口 · 随时停用" Margin="0,18,0,8"><StackPanel Margin="0,12,0,0">
            <TextBlock Text="一键停用会关闭管控、自启、守护、声音和浮层，保留学习记录及已获得许可。网站扩展最多一分钟同步，可在扩展中手动刷新；已经跳转到的学习页面需要重新打开目标网站。" TextWrapping="Wrap" Foreground="#657C78"/>
            <WrapPanel Margin="0,8,0,0"><Button Content="一键停用所有功能" Click="DebugDisable_Click"/><Button Content="停用并退出 EntLimit" Click="DebugStop_Click"/></WrapPanel>
            <Button Content="紧急关闭（独立工具）" Click="EmergencyStop_Click" HorizontalAlignment="Left" Margin="0,12,0,4" ToolTip="不依赖后台连接。打开独立工具关闭本安装的 EntLimit 进程并保留紧急停用标记。"/>
            <TextBlock Text="界面卡死时，可直接双击程序目录中的 EntLimit.EmergencyStop.exe（独立紧急停止工具）。工具会在独立窗口显示结果；重新打开程序后，需要主动解除紧急停用才会恢复管控。" TextWrapping="Wrap" Foreground="#657C78" Margin="0,4,0,8"/>
            <TextBlock x:Name="EmergencyStateText" Text="紧急停用标记生效中。保存规则或勾选管控不会解除；学习记录与已有许可保留。" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#8A6236" Margin="0,6,0,6"/>
            <Button x:Name="ResumeManagementButton" Content="解除紧急停用并恢复管控" Click="ResumeManagement_Click" HorizontalAlignment="Left" Visibility="Collapsed" IsEnabled="False" ToolTip="仅恢复管控；自启和守护保持关闭，之后可自行设置。"/>
          </StackPanel></Expander>
          <TextBlock Text="自定义主题入口" FontSize="18" Margin="0,20,0,0"/>
          <TextBlock Text="自动搜集资料与题目将在后续版本接入。当前可使用内置离线题库；不会把未校验的网上内容直接用于解锁。" TextWrapping="Wrap" Foreground="#657C78" Margin="0,8,0,0"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="学习记录"><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="一点一点，留下你的收获。" FontSize="22" Margin="0,0,0,12"/><ListBox x:Name="HistoryList" Grid.Row="1" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="#70F6F9FD" Padding="16" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Takeaway}" TextWrapping="Wrap" FontSize="16"/><TextBlock Text="{Binding CompletedAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm} UTC}" Foreground="#657C78" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
      <TabItem Header="API 与扩展"><Border x:Name="IntegrationHost"/></TabItem>
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="MaterialIndicator" DockPanel.Dock="Right" Margin="16,0,0,0" Text="本地练习" FontSize="11" Foreground="#657C78" VerticalAlignment="Center"/><TextBlock x:Name="Notice" Text="关闭窗口后托盘继续运行；规则页与托盘均保留调试停用入口。" Foreground="#657C78" TextWrapping="Wrap"/></DockPanel>
  </Grid></Grid></Grid>
</Window>
