{
  "manifest_version": 3,
  "name": "EntLimit Companion",
  "version": "0.1.0",
  "description": "Local learning gate for your selected entertainment websites.",
  "permissions": ["nativeMessaging", "storage", "alarms", "declarativeNetRequestWithHostAccess", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "web_accessible_resources": [{"resources": ["gate.html", "gate.js", "style.css"], "matches": ["http://*/*", "https://*/*"]}]
}
